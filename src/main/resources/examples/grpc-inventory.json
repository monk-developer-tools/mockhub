      "request": {
        "method": "POST",
        "urlPath": "/inventory.v1.StockService/WatchStock"
      },
      "response": {
        "status": 200,
        "jsonBody": { "sku": "sku-1", "name": "Blue mug", "quantity": 3, "availability": "LOW_STOCK", "updatedAt": "2026-01-15T09:30:00Z" }
      },
