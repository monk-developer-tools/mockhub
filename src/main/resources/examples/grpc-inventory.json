    {
      "name": "GetItem · sku-404 not found",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/inventory.v1.StockService/GetItem",
        "bodyPatterns": [ { "equalToJson": { "sku": "sku-404" }, "ignoreExtraElements": true } ]
      },
      "response": {
        "status": 200,
        "headers": { "grpc-status-name": "NOT_FOUND", "grpc-status-reason": "No item has sku sku-404" }
      },
      "metadata": { "mockhub": { "type": "grpc", "folder": "inventory.v1.StockService", "description": "Answers with a gRPC status instead of a message." } }
    },
    {
      "name": "GetItem · blocked tenant",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/inventory.v1.StockService/GetItem",
        "headers": { "x-tenant": { "equalTo": "blocked" } }
      },
      "response": {
        "status": 200,
        "headers": { "grpc-status-name": "PERMISSION_DENIED", "grpc-status-reason": "Tenant blocked has no access to inventory" }
      },
      "metadata": { "mockhub": { "type": "grpc", "folder": "inventory.v1.StockService", "description": "gRPC metadata is matched like HTTP headers." } }
    },
