{
  "imports": [
    {
      "format": "wsdl",
      "file": "calculator.wsdl",
      "options": {
        "path": "/ws/calculator"
      }
    }
  ],
  "stubs": [
    {
      "name": "CalculatorService · Add 2 + 3 = 5",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/ws/calculator",
        "bodyPatterns": [
          {
            "matchesXPath": {
              "expression": "//*[local-name()='Add']/*[local-name()='a']/text()",
              "equalTo": "2"
            }
          },
          {
            "matchesXPath": {
              "expression": "//*[local-name()='Add']/*[local-name()='b']/text()",
              "equalTo": "3"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=utf-8"
        },
        "body": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ns1:AddResponse xmlns:ns1=\"http://example.com/calculator\">\n      <ns1:result>5</ns1:result>\n    </ns1:AddResponse>\n  </soap:Body>\n</soap:Envelope>"
      },
      "metadata": {
        "mockhub": {
          "type": "soap",
          "soapVersion": "1.1",
          "soapAction": "http://example.com/calculator/Add",
          "folder": "CalculatorService",
          "description": "Matches on values inside the envelope with XPath; beats the generated Add stub (priority 1).",
          "sampleRequest": {
            "body": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ns1:Add xmlns:ns1=\"http://example.com/calculator\">\n      <ns1:a>2</ns1:a>\n      <ns1:b>3</ns1:b>\n    </ns1:Add>\n  </soap:Body>\n</soap:Envelope>"
          }
        }
      }
    },
    {
      "name": "CalculatorService · Add with negative input → Fault",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/ws/calculator",
        "bodyPatterns": [
          {
            "matchesXPath": "//*[local-name()='Add']/*[starts-with(text(),'-')]"
          }
        ]
      },
      "response": {
        "status": 500,
        "headers": {
          "Content-Type": "text/xml; charset=utf-8"
        },
        "body": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <soap:Fault>\n      <faultcode>soap:Client</faultcode>\n      <faultstring>Negative numbers are not supported</faultstring>\n    </soap:Fault>\n  </soap:Body>\n</soap:Envelope>"
      },
      "metadata": {
        "mockhub": {
          "type": "soap",
          "soapVersion": "1.1",
          "folder": "CalculatorService",
          "sampleRequest": {
            "body": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ns1:Add xmlns:ns1=\"http://example.com/calculator\">\n      <ns1:a>-1</ns1:a>\n      <ns1:b>3</ns1:b>\n    </ns1:Add>\n  </soap:Body>\n</soap:Envelope>"
          }
        }
      }
    }
  ]
}
